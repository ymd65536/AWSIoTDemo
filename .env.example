# src/publisher.py / src/subscriber.py が読み込む設定のひな形です。
# scripts/setup.sh を実行すると、実際の値が入った .env が自動生成されます。
# 手動で作成する場合は、このファイルを .env にコピーして値を書き換えてください。
#
# 注意:
# - .env は .gitignore で除外されています。コミットしないでください。
# - AWS アクセスキーはここに書きません。デバイスは X.509 証明書だけで接続します。
# - AWS CLI 用の AWS_REGION / AWS_PROFILE はシェルの環境変数で指定します (README 参照)。

# AWS IoT Core のデータエンドポイント (aws iot describe-endpoint --endpoint-type iot:Data-ATS)
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.ap-northeast-1.amazonaws.com

# MQTT のポート。8883 が遮断されるネットワークでは 443 (ALPN) を指定します。
IOT_PORT=8883

# サーバー証明書の検証に使うルート CA。空にすると OS の信頼ストアを使います。
IOT_CA_FILE=certs/AmazonRootCA1.pem

# Topic の先頭セグメント。IoT Policy / IoT Rule と一致させる必要があります。
IOT_TOPIC_ROOT=handson

# Publisher (テレメトリを送信するデバイス役)
PUBLISHER_THING_NAME=iot-handson-publisher
PUBLISHER_CERT_FILE=certs/publisher/certificate.pem.crt
PUBLISHER_KEY_FILE=certs/publisher/private.pem.key

# Subscriber (テレメトリを受信するアプリケーション役)
SUBSCRIBER_THING_NAME=iot-handson-subscriber
SUBSCRIBER_CERT_FILE=certs/subscriber/certificate.pem.crt
SUBSCRIBER_KEY_FILE=certs/subscriber/private.pem.key
